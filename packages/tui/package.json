{
  "name": "@agent-group-lab/tui",
  "version": "0.2.0",
  "type": "module",
  "private": "true",
  "scripts": {
    "clean": "rimraf ./node_modules dist",
    "bundle": "rimraf ./dist && bun run ./scripts/bundle.ts",
    "check:type": "tsc -p ./tsconfig.json --noEmit",
    "check:lint": "biome check --write"
  },
  "dependencies": {
    "@agent-group-lab/session": "workspace:^",
    "ink": "7.1.0",
    "react-devtools-core": "7.0.1",
    "react": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "bun-types": "1.3.14"
  },
  "nx": {
    "targets": {
      "bundle": {
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/dist/tui"
        ]
      }
    }
  }
}
