{
  "name": "@agent-group-lab/session",
  "version": "1.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf ./dist && tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "clean": "rimraf ./node_modules dist",
    "check:lint": "biome check --write",
    "check:type": "tsc -p ./tsconfig.json --noEmit",
    "check:dep": "depcruise --config .dependency-cruiser.mjs src"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@agent-group-lab/agent-host-runtime-node": "workspace:^",
    "@agent-group-lab/contracts": "workspace:^",
    "string-width": "8.2.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "ink": ">=7.0.0",
    "mobx": ">=6.0.0",
    "mobx-react-lite": ">=4.0.0",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "bun-types": "1.3.14",
    "ink": "7.1.0",
    "mobx": "6.16.1",
    "mobx-react-lite": "4.1.1",
    "react": "19.2.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agent-group-lab/agent-host",
    "directory": "packages/agent-session"
  }
}
